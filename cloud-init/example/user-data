#cloud-config
# Example only: replace the public-key placeholder with your own actual SSH public key.
hostname: micro1
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users:
  - name: ubuntu
    groups: [adm, sudo]
    shell: /bin/bash
    lock_passwd: true
    # This was a convenience in the isolated lab, not a production privilege model.
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"
