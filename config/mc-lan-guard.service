[Unit]
Description=MicroCloud LAN isolation firewall
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/mc-lan-guard.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/mc-lan-guard.nft
ExecStop=/usr/sbin/nft delete table inet mc_lan_guard

[Install]
WantedBy=multi-user.target
